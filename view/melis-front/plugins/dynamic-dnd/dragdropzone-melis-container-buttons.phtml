<div class="column-icons">
    <?php
    foreach ($this->dndLayouts as $k => $layout) {
        $dndTpl = 'data-dnd-tpl="' . $k . '"';
        if ($this->dndLayoutTemplate == $layout['template'])
            $dndTpl = "dnd-layout-disable";

        if (!empty($layout['template']) && (!empty($layout['html-button-icon'])))
            // SECURITY (audit FE-H2) : melisSite vient de la QUERY STRING — échappé (breakout
            // d'attribut → XSS dans l'origine du site avec la session BO de l'éditeur).
            echo '<div class="dnd-column-layout" data-dnd-id="' . $this->dndId . '" ' . $dndTpl . ' data-page-id="' . (int) $this->pageId . '" data-melis-site="' . htmlspecialchars((string) ($_GET['melisSite'] ?? ''), ENT_QUOTES, 'UTF-8') . '">' . $layout['html-button-icon'] . '</div>';
    }
    ?>
</div>